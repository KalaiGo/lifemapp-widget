<?xml version="1.0" encoding="utf-8"?>
<!-- Corner brackets (10dp) and edge ticks (4dp) of the target frame (web .pd-target). White mask, tinted at render time. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|left" android:width="10dp" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="top|left" android:width="1dp" android:height="10dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="top|right" android:width="10dp" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="top|right" android:width="1dp" android:height="10dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="bottom|left" android:width="10dp" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="bottom|left" android:width="1dp" android:height="10dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="bottom|right" android:width="10dp" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="bottom|right" android:width="1dp" android:height="10dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="1dp" android:height="4dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="bottom|center_horizontal" android:width="1dp" android:height="4dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="left|center_vertical" android:width="4dp" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:gravity="right|center_vertical" android:width="4dp" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
</layer-list>
