<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for DashboardWidget (4x4): hero, then shortcuts, events and tasks. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lm_preview_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hello"
                android:textAllCaps="true"
                android:textColor="@color/lm_preview_text_variant"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_name"
                android:textColor="@color/lm_preview_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_date"
                android:textColor="@color/lm_preview_text_variant"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lm_ic_cloud_sun"
            android:tint="@color/lm_preview_text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_temp"
            android:textColor="@color/lm_preview_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/lm_preview_surface"
        android:orientation="horizontal"
        android:paddingVertical="4dp">
        <include
            layout="@layout/widget_preview_counter_events" />
        <include
            layout="@layout/widget_preview_counter_tasks" />
        <include
            layout="@layout/widget_preview_counter_mail" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lm_ic_link"
            android:tint="@color/lm_preview_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shortcuts"
            android:textColor="@color/lm_preview_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/lm_preview_chip"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/lm_ic_mail"
                android:tint="@color/lm_preview_on_primary_container" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/preview_link_1"
                android:textColor="@color/lm_preview_text"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/lm_preview_chip"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/lm_ic_music"
                android:tint="@color/lm_preview_on_primary_container" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/preview_link_2"
                android:textColor="@color/lm_preview_text"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/lm_preview_chip"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/lm_ic_map"
                android:tint="@color/lm_preview_on_primary_container" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/preview_link_3"
                android:textColor="@color/lm_preview_text"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/lm_preview_chip"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/lm_ic_globe"
                android:tint="@color/lm_preview_on_primary_container" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/preview_link_4"
                android:textColor="@color/lm_preview_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lm_ic_calendar"
            android:tint="@color/lm_preview_primary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/events"
            android:textColor="@color/lm_preview_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today"
            android:textColor="@color/lm_preview_text_variant"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/lm_preview_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">
        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/lm_preview_bar" />
        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="09:00"
            android:textColor="@color/lm_preview_text_variant"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/preview_event_1"
            android:textColor="@color/lm_preview_text"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/lm_preview_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">
        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/lm_preview_bar" />
        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="13:00"
            android:textColor="@color/lm_preview_text_variant"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/preview_event_2"
            android:textColor="@color/lm_preview_text"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lm_ic_list_checks"
            android:tint="@color/lm_preview_primary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tasks"
            android:textColor="@color/lm_preview_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/preview_tasks_open"
            android:textColor="@color/lm_preview_text_variant"
            android:textSize="12sp" />
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lm_ic_plus"
            android:tint="@color/lm_preview_primary" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/lm_preview_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lm_ic_circle"
            android:tint="@color/lm_preview_primary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/preview_task_1"
            android:textColor="@color/lm_preview_text"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/lm_preview_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lm_ic_circle"
            android:tint="@color/lm_preview_primary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/preview_task_2"
            android:textColor="@color/lm_preview_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
