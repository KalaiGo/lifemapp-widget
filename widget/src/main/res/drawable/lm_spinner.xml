<?xml version="1.0" encoding="utf-8"?>
<!-- Rotating ring drawable: keeps spinning (and never collapses to a dot) when system animator duration scale is 0. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/lm_spinner_ring"
    android:fromDegrees="0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="360" />
